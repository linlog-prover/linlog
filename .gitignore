# cargo
/target

# The fuzz targets' builds, corpora and findings (fuzz/run.sh)
/fuzz/target
/fuzz/corpus
/fuzz/artifacts

# Python's bytecode of the hooks' shared module
__pycache__/

# nix
result*
# The LLTP library, `nix build .#lltp -o bench/lltp`
/bench/lltp
# The ILTP library's propositional problems, `nix build .#iltp -o bench/iltp`
/bench/iltp
# The qcover coverability suite, `nix build .#qcover -o bench/qcover`
/bench/qcover
.direnv/

# Tracked even where a global ignore excludes .envrc files.
!.envrc

# Emacs auto-save files (#file#), lock files (.#file) and backups (file~)
\#*\#
.\#*
*~

# The author's notes
scratchpad*.md

# Claude Code: personal, per-machine overrides
.claude/settings.local.json
CLAUDE.local.md
# The baseline's rows, which `result*` above would hide, but not its
# progress logs
!/bench/results/
/bench/results/*/*.log
# The target set's progress logs and its streams' files while it runs
/bench/targets/*.log
/bench/targets/*.[0-9].csv
/bench/targets/*.part.csv
# Trial runs of the target set
/bench/targets/scratch-*
# The comparison's progress logs, each run's scratch files and its
# streams' rows, which runs.csv joins
/bench/comparison/*/*.log
/bench/comparison/*/work-*
/bench/comparison/*/seq-*.csv
/bench/comparison/*/default-*.csv
